{
  "Vehicle": {
    "type": "branch",
    "description": "Root vehicle branch for the DMS Driver Safety HMI demo.",
    "children": {
      "Speed": {
        "type": "sensor",
        "datatype": "float",
        "unit": "km/h",
        "description": "Current ego vehicle speed."
      },
      "SpeedLimit": {
        "type": "sensor",
        "datatype": "float",
        "unit": "km/h",
        "description": "Current road speed limit."
      },
      "Driver": {
        "type": "branch",
        "description": "Driver monitoring signals inferred by AI.",
        "children": {
          "State": {
            "type": "sensor",
            "datatype": "string",
            "description": "AI driver state: alert, drowsy, yawning, distracted or microsleep."
          },
          "AlertnessScore": {
            "type": "sensor",
            "datatype": "float",
            "min": 0,
            "max": 1,
            "description": "AI driver alertness score in the range 0..1."
          }
        }
      },
      "ADAS": {
        "type": "branch",
        "description": "DMS safety signals for the in-vehicle HMI.",
        "children": {
          "MinTTC": {
            "type": "sensor",
            "datatype": "float",
            "unit": "s",
            "min": 0,
            "description": "Minimum finite TTC; Infinity is omitted by Backend."
          },
          "Headway": {
            "type": "sensor",
            "datatype": "float",
            "unit": "s",
            "min": 0,
            "description": "Finite following headway."
          },
          "FinalRiskScore": {
            "type": "sensor",
            "datatype": "float",
            "min": 0,
            "max": 100,
            "description": "Risk evidence emitted by AI; never recomputed by Backend."
          },
          "CriticalAlert": {
            "type": "actuator",
            "datatype": "boolean",
            "description": "Whether a critical AI safety episode is active."
          },
          "DisplaySeverity": {
            "type": "actuator",
            "datatype": "string",
            "description": "SAFE, WARNING, CRITICAL or RECOVERY."
          },
          "AlertReasonCode": {
            "type": "actuator",
            "datatype": "string",
            "description": "Upper-case AI alert type translated for HMI display."
          },
          "RecommendedActionCode": {
            "type": "actuator",
            "datatype": "string",
            "description": "Stable HMI action code selected from the AI alert type."
          },
          "EventTransition": {
            "type": "actuator",
            "datatype": "string",
            "description": "NONE, START, UPDATE or END."
          },
          "AIStatus": {
            "type": "actuator",
            "datatype": "string",
            "description": "ONLINE, DEGRADED or OFFLINE."
          },
          "DataAgeMs": {
            "type": "actuator",
            "datatype": "uint32",
            "unit": "ms",
            "description": "Age of the latest AI event."
          }
        }
      }
    }
  }
}
