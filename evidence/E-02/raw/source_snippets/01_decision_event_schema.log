   125	    def transport_dict(self) -> dict[str, Any]:
   126	        """JSON-safe payload; non-finite internal values become null."""
   127	
   128	        def clean(value: Any) -> Any:
   129	            if isinstance(value, float) and not math.isfinite(value):
   130	                return None
   131	            if isinstance(value, dict):
   132	                return {key: clean(item) for key, item in value.items()}
   133	            if isinstance(value, (list, tuple)):
   134	                return [clean(item) for item in value]
   135	            return value
