    87	    def map_decision_event(
    88	        self,
    89	        event: Mapping[str, Any],
    90	        *,
    91	        data_age_ms: int = 0,
    92	    ) -> dict[str, list[dict[str, Any]]]:
    93	        """Map the AI-owned DecisionEvent without recomputing its decision.
    94	
    95	        Only evidence already emitted by AI is forwarded. Missing telemetry is
    96	        omitted instead of fabricated. Alert type/severity/lifecycle remain
    97	        owned by AI; Backend only translates them to the stable VSS vocabulary.
    98	        """
    99	        if data_age_ms < 0:
   100	            raise ValueError("data_age_ms must not be negative")
   101	        status = str(event.get("status", "update")).lower()
   102	        severity = str(event.get("severity", "warning")).lower()
   103	        alert_type = str(event.get("alert_type", "unknown"))
   104	        evidence = event.get("evidence") or {}
   105	        if not isinstance(evidence, Mapping):
   106	            evidence = {}
   107	
   108	        hmi_state = (
   109	            CarSkyHMIState.RECOVERY
   110	            if status == "resolved"
   111	            else CarSkyHMIState.CRITICAL
   112	            if severity == "critical"
   113	            else CarSkyHMIState.WARNING
   114	        )
   115	        transition = {
   116	            "open": EventTransition.START,
   117	            "update": EventTransition.UPDATE,
   118	            "resolved": EventTransition.END,
   119	        }.get(status, EventTransition.UPDATE)
   120	        reason_code = {
   121	            "collision_risk": "TTC_CRITICAL",
   122	            "microsleep": "MICROSLEEP",
   123	            "driver_drowsiness": "DROWSY",
   124	            "driver_distraction": "DISTRACTED",
   125	            "yawning": "YAWNING",
   126	            "tailgating": "TAILGATING",
   127	            "speeding": "SPEEDING",
   128	            "harsh_brake": "HARSH_BRAKE",
   129	            "harsh_accel": "HARSH_ACCEL",
   130	            "harsh_corner": "HARSH_CORNER",
   131	        }.get(alert_type, "NONE")
   132	        action_code = {
   133	            "collision_risk": "BRAKE_SAFE",
   134	            "microsleep": "TAKE_BREAK",
   135	            "driver_drowsiness": "TAKE_BREAK",
   136	            "driver_distraction": "FOCUS_FORWARD",
   137	            "speeding": "REDUCE_SPEED",
   138	        }.get(alert_type, "NONE")
   139	
   140	        payload = {
   141	            "driver_state": evidence.get("driver_state"),
   142	            "alertness_score": evidence.get("alertness_score"),
   143	            "speed_kmh": evidence.get("speed_kmh"),
   144	            "predicted_ttc_sec": evidence.get("predicted_ttc_sec"),
   145	            "risk_score": evidence.get("c3_risk_score"),
   146	            "severity": hmi_state.value,
   147	            "critical_alert": hmi_state is CarSkyHMIState.CRITICAL,
   148	            "recommended_action": action_code,
   149	            "ai_status": AIStatus.ONLINE.value,
   150	        }
   151	        return self.map_live_snapshot(
   152	            payload,
   153	            data_age_ms=data_age_ms,
   154	            transition=transition.value,
   155	            realtime=False,
   156	        )
