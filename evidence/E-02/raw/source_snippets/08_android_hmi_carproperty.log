   667	    private void unregisterVehicleCallback() {
   668	        if (propertyManager == null || propertyCallback == null) return;
   669	        try {
   670	            Class<?> callbackClass = Class.forName("android.car.hardware.property.CarPropertyManager$CarPropertyEventCallback");
   671	            propertyManager.getClass().getMethod("unregisterCallback", callbackClass).invoke(propertyManager, propertyCallback);
   672	        } catch (Throwable ignored) {
   673	            // Best effort during Activity teardown.
   674	        }
   675	    }
