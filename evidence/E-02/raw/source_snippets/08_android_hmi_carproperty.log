   325	    private void registerVehicleCallback() throws Exception {
   326	        Class<?> callbackClass = Class.forName("android.car.hardware.property.CarPropertyManager$CarPropertyEventCallback");
   327	        propertyCallback = Proxy.newProxyInstance(
   328	                callbackClass.getClassLoader(),
   329	                new Class<?>[]{callbackClass},
   330	                new VehicleCallbackHandler());
   331	        Method register = propertyManager.getClass().getMethod("registerCallback", callbackClass, int.class, float.class);
   332	        for (int propId : DMS_PROPS) {
   333	            try {
   334	                Object ok = register.invoke(propertyManager, propertyCallback, propId, SENSOR_RATE_HZ);
   335	                Log.i(TAG, "register 0x" + Integer.toHexString(propId) + "=" + ok);
   336	            } catch (Throwable propError) {
   337	                Log.w(TAG, "register failed 0x" + Integer.toHexString(propId), propError);
   338	            }
   339	        }
   340	    }
   341	
   342	    private final class VehicleCallbackHandler implements InvocationHandler {
   343	        @Override
   344	        public Object invoke(Object proxy, Method method, Object[] args) {
   345	            String name = method.getName();
   346	            if ("hashCode".equals(name)) {
   347	                return System.identityHashCode(proxy);
   348	            } else if ("equals".equals(name)) {
   349	                return args != null && args.length > 0 && proxy == args[0];
   350	            } else if ("toString".equals(name)) {
   351	                return "DMS CarPropertyEventCallback";
   352	            } else if ("onChangeEvent".equals(name) && args != null && args.length > 0) {
   353	                handleCarPropertyEvent(args[0]);
   354	            } else if ("onErrorEvent".equals(name)) {
   355	                Log.e(TAG, "CarProperty callback error");
   356	            }
   357	            return null;
   358	        }
   359	    }
   360	
   361	    private void handleCarPropertyEvent(Object event) {
   362	        try {
   363	            Object propertyValue = event;
   364	            try {
   365	                propertyValue = event.getClass().getMethod("getCarPropertyValue").invoke(event);
   366	            } catch (NoSuchMethodException ignored) {
   367	                // Android AAOS CarPropertyManager callback already passes CarPropertyValue.
   368	            }
   369	            Object raw = propertyValue.getClass().getMethod("getValue").invoke(propertyValue);
   370	            int propId = PERF_VEHICLE_SPEED;
   371	            try {
   372	                Object id = propertyValue.getClass().getMethod("getPropertyId").invoke(propertyValue);
   373	                if (id instanceof Number) propId = ((Number) id).intValue();
   374	            } catch (Throwable ignored) {
   375	                // Keep speed-mux fallback for older AAOS APIs.
   376	            }
   377	            if (raw != null) {
   378	                decodeProperty(propId, raw);
   379	                handler.post(new Runnable() {
   380	                    @Override
   381	                    public void run() {
   382	                        render();
   383	                    }
   384	                });
   385	            }
   386	        } catch (Throwable error) {
   387	            Log.e(TAG, "Cannot decode VHAL event", error);
   388	        }
   389	    }
   390	
   391	    private void decodeProperty(int propId, Object raw) {
   392	        state.lastUpdateAt = System.currentTimeMillis();
   393	        if (raw instanceof Number) {
   394	            float value = ((Number) raw).floatValue();
   395	            if (propId == PERF_VEHICLE_SPEED) {
   396	                decodeMultiplex(value);
   397	            } else if (propId == PROP_FINAL_RISK) {
   398	                state.risk = value;
   399	            } else if (propId == PROP_CRITICAL_ALERT) {
   400	                state.critical = Math.round(value) == 1;
   401	            } else if (propId == PROP_ALERTNESS) {
   402	                state.alertness = value > 1.0f ? value / 100.0f : value;
   403	            } else if (propId == PROP_MIN_TTC) {
   404	                state.ttc = value;
   405	            } else if (propId == PROP_AI_STATUS) {
   660	        if (tts != null) {
   661	            tts.stop();
   662	            tts.shutdown();
   663	        }
   664	        super.onDestroy();
   665	    }
