{
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "trip_id": {
      "minLength": 1,
      "title": "Trip Id",
      "type": "string"
    },
    "driver_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Driver Id"
    },
    "frame_id": {
      "minimum": 0,
      "title": "Frame Id",
      "type": "integer"
    },
    "trip_timestamp_ms": {
      "minimum": 0,
      "title": "Trip Timestamp Ms",
      "type": "integer"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "update",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "alert_type": {
      "minLength": 1,
      "title": "Alert Type",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "audiences": {
      "items": {
        "enum": [
          "driver_display",
          "fleet_dashboard"
        ],
        "type": "string"
      },
      "title": "Audiences",
      "type": "array"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "recommended_action": {
      "minLength": 1,
      "title": "Recommended Action",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "idempotency_key",
    "trip_id",
    "frame_id",
    "trip_timestamp_ms",
    "timestamp_utc",
    "status",
    "alert_type",
    "severity",
    "confidence",
    "audiences",
    "recommended_action"
